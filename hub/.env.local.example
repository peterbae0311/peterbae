NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── image_slideshow API 라우트 (/api/image-slideshow/*) ──────────────────
# image_slideshow 자체 Supabase 프로젝트(hub와 다른 프로젝트) URL.
# 이 프로젝트는 비대칭 JWT 서명 키(ECC)로 전환되어 있어 고정 비밀키 대신
# /auth/v1/.well-known/jwks.json의 공개키로 access_token을 검증한다 (auth.ts 참고).
IMAGE_SLIDESHOW_SUPABASE_URL=

# Oracle Autonomous DB (node-oracledb thin mode) — eungmomoa-db는 Always Free라 mTLS 지갑 필수.
# WALLET_LOCATION은 배포 서버의 고정 절대경로를 가리켜야 함(실제 배포 서버: /home/opc/apps/oracle-wallet) —
# oracle/wallet/은 git에 올라가지 않으므로 서버에 별도로 scp 등으로 올려둘 것.
IMAGE_SLIDESHOW_ORACLE_USER=
IMAGE_SLIDESHOW_ORACLE_PASSWORD=
IMAGE_SLIDESHOW_ORACLE_CONNECT_STRING=
IMAGE_SLIDESHOW_ORACLE_WALLET_LOCATION=
IMAGE_SLIDESHOW_ORACLE_WALLET_PASSWORD=

# OCI Object Storage (PAR 발급용 — API signing key 방식)
IMAGE_SLIDESHOW_OCI_TENANCY_OCID=
IMAGE_SLIDESHOW_OCI_USER_OCID=
IMAGE_SLIDESHOW_OCI_FINGERPRINT=
IMAGE_SLIDESHOW_OCI_PRIVATE_KEY=
IMAGE_SLIDESHOW_OCI_REGION=
IMAGE_SLIDESHOW_OCI_NAMESPACE=
IMAGE_SLIDESHOW_OCI_BUCKET=
