# cp .env.example .env 후 값을 채우세요. (.env는 저장소 최상단 .gitignore가 이미 무시함)

# ── 이관 원본: image_slideshow의 Supabase 프로젝트 ─────────────────
SUPABASE_URL=https://pnudzuajpuvhcyhxjwva.supabase.co
# Settings → API → service_role key (RLS를 우회해 모든 행/파일을 읽어야 함 — anon key 아님)
SUPABASE_SERVICE_ROLE_KEY=

# ── 이관 대상: Oracle Autonomous DB (hub/.env.local.example과 동일한 값) ──
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=

# ── 이관 대상: OCI Object Storage (hub/.env.local.example과 동일한 값) ──
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY=
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET=
